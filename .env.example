# Copy to .env or export these variables in your shell. Never commit real secrets.
QDRANT_URL=https://YOUR-CLUSTER.cloud.qdrant.io:6333
QDRANT_API_KEY=replace-with-your-api-key
QDRANT_COLLECTION_PREFIX=vibiomir

# Absolute PyTorch allocator cap. 3.0 GiB leaves CUDA-context headroom below
# the project's hard 4 GiB VRAM limit and 3.5 GiB operational target.
VIBIOMIR_GPU_MAX_GIB=3.0
VIBIOMIR_GPU_CPU_FALLBACK=1
